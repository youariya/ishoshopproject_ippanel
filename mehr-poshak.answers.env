# فایل جواب‌های آماده برای «پوشاک مهر» — قسمت‌های TODO را پر کنید، بقیه آماده است.
# اجرا روی سرور: bash scripts/onboard-client.sh mehr-poshak.answers.env

# --- استقرار روی سرور ---
CLIENT_SLUG="mehr-poshak"
CLIENT_PORT="3001"
CLIENT_DOMAIN=""

# --- .env این مشتری ---
SESSION_SECRET=""
SMS_PROVIDER="ippanel"
KAVEHNEGAR_API_KEY=""
KAVENEGAR_SENDER_LINE=""
IPPANEL_API_KEY="TODO"
IPPANEL_SENDER_NUMBER="TODO"
IPPANEL_PATTERN_WELCOME=""
IPPANEL_PATTERN_DEBT=""
IPPANEL_PATTERN_PAYMENT=""
ADMIN_PHONE_NUMBER="TODO"
APPSCRIPT_URL="TODO"
DEFAULT_TEMP_PASSWORD="TODO"

# --- config/client.json این مشتری (از قبل مطابق چیزی که خودتان خواستید پر شده) ---
BUSINESS_NAME="پوشاک مهر"
SMS_SIGNATURE="👗پوشاک مهر ؛ ۲۷سال همراهی باسلیقه بانوان شهرم🛍"

SMS_WELCOME_ENABLED="false"
SMS_WELCOME_MESSAGE=""

SMS_DEBT_ENABLED="true"
SMS_DEBT_MESSAGE="{name} گرامی خرید شما به مبلغ {amount} تومان ثبت شد. مبلغ باقی مانده از کل حساب شما {remaining_debt} تومان می باشد.\n{signature}"

SMS_PAYMENT_ENABLED="true"
SMS_PAYMENT_MESSAGE="{name} گرامی پرداخت وجه در تاریخ {date} با موفقیت ثبت شد. مبلغ پرداخت شده: {amount} تومان مبلغ باقی مانده: {remaining_debt} تومان\n{signature}"
