# پورت اجرای این نمونه روی سرور — هر مشتری باید پورت داخلی جدا داشته باشد
PORT=3000

# کلید امن سشن — برای هر مشتری باید یک مقدار تصادفی و یکتا تولید شود (مثلا: openssl rand -hex 32)
SESSION_SECRET=

# سرویس‌دهنده پیامک: kavenegar یا ippanel
SMS_PROVIDER=ippanel

# کاوه‌نگار (در صورت SMS_PROVIDER=kavenegar)
KAVEHNEGAR_API_KEY=
KAVENEGAR_SENDER_LINE=

# ایپی‌پانل / مدیرپیامک (در صورت SMS_PROVIDER=ippanel)
IPPANEL_API_KEY=
IPPANEL_SENDER_NUMBER=

# کد پترن‌های تاییدشده در پنل ایپی‌پانل برای پیامک‌های عملیاتی (پس از تایید پترن پر شود — scripts/createIppanelPatterns.js)
# فقط برای پیامک‌هایی که در config/client.json برای این مشتری enabled:true هستند لازم است
IPPANEL_PATTERN_WELCOME=
IPPANEL_PATTERN_DEBT=
IPPANEL_PATTERN_PAYMENT=

# شماره موبایل مدیر برای دریافت اخطارهای سیستمی
ADMIN_PHONE_NUMBER=

# آدرس Google Apps Script برای ثبت لاگ پیامک‌ها
APPSCRIPT_URL=
