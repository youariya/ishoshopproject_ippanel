# فایل جواب‌های آنبوردینگ — یک کپی از این فایل با اطلاعات واقعی مشتری پر کنید
# و روی سرور اجرا کنید: bash scripts/onboard-client.sh این-فایل.env
#
# نکته‌ی مهم: هر مقدار را دقیقاً همین‌طور داخل "..." بنویسید (حتی اگر فاصله ندارد)؛
# چون این فایل مستقیماً با bash خوانده می‌شود و بدون " دور مقادیر دارای فاصله خراب می‌شود.
# هرچیزی که خالی بگذارید ("") بعداً می‌توانید دستی در .env مشتری تکمیل کنید.

# --- استقرار روی سرور ---
CLIENT_SLUG=""
CLIENT_PORT=""
CLIENT_DOMAIN=""

# --- .env این مشتری ---
# SESSION_SECRET را خالی بگذارید — خودش یک مقدار تصادفی امن می‌سازد
SESSION_SECRET=""
SMS_PROVIDER=""
KAVEHNEGAR_API_KEY=""
KAVENEGAR_SENDER_LINE=""
IPPANEL_API_KEY=""
IPPANEL_SENDER_NUMBER=""
IPPANEL_PATTERN_WELCOME=""
IPPANEL_PATTERN_DEBT=""
IPPANEL_PATTERN_PAYMENT=""
ADMIN_PHONE_NUMBER=""
APPSCRIPT_URL=""
DEFAULT_TEMP_PASSWORD=""

# --- config/client.json این مشتری ---
BUSINESS_NAME=""
SMS_SIGNATURE=""

# هر پیام باید در یک خط نوشته شود؛ برای خط جدید داخل متن پیامک از \n استفاده کنید
# (دو کاراکتر: بک‌اسلش و n)، نه اینتر واقعی.
# متغیرهای قابل استفاده داخل متن: {name} {amount} {remaining_debt} {date} {signature}
# هرکدام را خالی بگذارید تا از متن پیش‌فرض عمومی استفاده شود.
SMS_WELCOME_ENABLED="true"
SMS_WELCOME_MESSAGE=""

SMS_DEBT_ENABLED="true"
SMS_DEBT_MESSAGE=""

SMS_PAYMENT_ENABLED="true"
SMS_PAYMENT_MESSAGE=""
